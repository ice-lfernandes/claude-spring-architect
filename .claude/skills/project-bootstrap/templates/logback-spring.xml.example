<!--
EXEMPLAR — goes to <project>/src/main/resources/logback-spring.xml.

This file is the mechanical half of .claude/rules/logging.md § logback.xml. The rule
fixes the pattern and the field; this file is where it actually runs.

One file, in the module with `contains_main: true`, no per-module copy — logback
resolves this file from the classpath root, so it has to live under `src/main/resources`
to be found at all. A copy in another module only creates places to diverge.
`logback-spring.xml` (not plain `logback.xml`) so Spring Boot's own profile-aware
initialization picks it up, instead of plain Logback resolving it before Boot's context
exists.

traceId is an MDC key. Where the value comes from (tracing bridge vs. generated UUID)
is .claude/rules/observability.md's decision, not this file's — this file only reserves
the field's place in the line.

No JSON encoder here by default. If the project later declares a structured-logging
dependency (e.g. logstash-logback-encoder), replace the PatternLayoutEncoder below with
that encoder in the same change that adds the dependency — update
.claude/rules/logging.md's pattern line too, so the rule and this file don't diverge.
-->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="app"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%magenta(%d{yyyy-MM-dd HH:mm:ss} app=${appName} [%thread] [%X{traceId}:%X{spanId}]) %cyan(%logger{36}) %highlight(%-5level M=%M, %msg%n)
            </pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
