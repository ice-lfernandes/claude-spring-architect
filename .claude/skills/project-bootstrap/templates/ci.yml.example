# EXEMPLAR — .github/workflows/build.yml of the generated project.
# The Initializr doesn't generate CI; this is the only exemplar for this file. Adjust the
# project name and Java distribution to what the blueprint/Initializr resolved in step 3.
# Tested: runs green against a project generated by this skill (hexagonal blueprint).
#
# Only runs what exists in the generated project. No `.claude/.ci/BoundaryTest.java`: that
# file lives in claude-spring-architect and no bootstrap step copies it, so a step invoking it
# would start out red. The boundary test is done in step 8 of the skill, by hand.
name: build

on:
  push: { branches: [main] }
  pull_request:
  workflow_dispatch:

jobs:
  build:
    name: build and tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven

      # The GitHub runner has a Docker daemon, so Testcontainers-based tests
      # actually run here — they aren't skipped like on a machine without Docker.
      # Checkstyle runs inside verify, in the validate phase.
      - name: verify
        run: ./mvnw -B clean verify

      # `.claude/rules/testing.md` § Database in integration tests: the
      # `@EnabledIf(dockerAvailable)` guard is allowed locally, not in CI. Without this
      # check the guard turns into a universal skip and `verify` goes green without having
      # touched the database — the silent degradation the rule forbids.
      #
      # Keyed off *IT.java source presence, not off the report alone: a freshly
      # bootstrapped project (see decisions/0011) has zero business code and therefore
      # zero *IT sources — that state must pass, not fail. Once the first *IT lands,
      # the check gains teeth: sources without a report, or a report with zero tests,
      # both fail the build.
      - name: integration tests actually ran
        run: |
          IT_SOURCES=$(find . -path '*/src/test/java/*IT.java' -print -quit)
          if [ -z "$IT_SOURCES" ]; then
            echo "ℹ️  No *IT.java sources yet — nothing to verify."
            exit 0
          fi
          REPORTS=$(find . -path '*/target/failsafe-reports/*IT.txt' -print -quit)
          if [ -z "$REPORTS" ]; then
            echo "❌ *IT.java sources exist but no failsafe report. Either failsafe isn't"
            echo "   wired up, or the Docker guard skipped them all. In CI that's a failure."
            exit 1
          fi
          if grep -rlE '^Tests run: 0' --include='*IT.txt' . ; then
            echo "❌ An IT ran with 0 tests — Docker guard active in CI."; exit 1
          fi
          echo "✅ Integration tests ran against a real container."

      - name: formatting
        run: ./mvnw -B spotless:check

  boundaries:
    name: architectural boundaries
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      # Proves enforcement is switched on for this machine, not just declared.
      - name: doctor
        run: java .claude/hooks/ArchHook.java doctor
