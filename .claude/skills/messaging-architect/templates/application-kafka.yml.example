# EXEMPLAR — Kafka producer/consumer configuration.
# Rules: `.claude/rules/messaging.md` § Delivery semantics, § Configuration
# Mandatory values come from the rule; sizing (group id, offset reset) is this skill's
# per-use-case call, fixed in the `25-mensageria.md` partial, not re-decided here.
#
# THE DEPENDENCY THAT MAKES THIS FILE DO ANYTHING. Every property below is read by Spring
# Boot's Kafka autoconfiguration, and in Spring Boot 4 that autoconfiguration is NOT in
# `spring-boot-autoconfigure` any more — it lives in its own module, pulled by
# `org.springframework.boot:spring-boot-starter-kafka` (first published at 4.1.0). A plain
# `org.springframework.kafka:spring-kafka` library dependency therefore wires nothing: no
# `KafkaTemplate`, no `ProducerFactory`, and this whole block silently inert while a
# hand-rolled `@Configuration` reads the same keys with `@Value` and squats the framework's
# own `spring.kafka.*` namespace — lessons-learned-013 § 8.5. Depend on the starter, let the
# Boot parent manage its version (`@CLAUDE.md` invariant 8: never a version from memory), and
# keep hand-wiring for what the starter genuinely cannot express.
# The dependency itself is a DECLARED DEPENDENCY REQUIREMENT in § 7 of the partial — see
# `messaging-spec.md.example`; the executor applies it, nobody else edits `pom.xml`.

spring:
  kafka:
    # Host-first default, and the reason is the one that broke a real run. `docker-compose`
    # publishes the broker's external listener on the host; the application started with
    # `./mvnw spring-boot:run` runs ON the host, so this default has to be an address the host
    # resolves. The `app` service inside compose overrides it with the compose-network address
    # (`KAFKA_BOOTSTRAP_SERVERS: kafka:9092`), which is where the internal listener answers.
    # Defaulting to the container-only port instead sends every host-side developer into
    # `UnknownHostException: kafka` with no way to know why — lessons-learned-013 § 11.
    # The port here and the EXTERNAL listener in `docker-architect`'s Kafka service block are
    # one decision in two files; `ArchHook.java compose` fails when they disagree.
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:localhost:29092}
    producer:
      acks: all
      properties:
        enable.idempotence: true
      retries: 3
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
    consumer:
      group-id: ${KAFKA_CONSUMER_GROUP}
      auto-offset-reset: earliest
      enable-auto-commit: false
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring.json.trusted.packages: "com.example.demo.adapter.in.messaging"
    listener:
      ack-mode: manual
      # Backoff: 3 attempts, 1s / 2s / 4s, then DLQ — wired once in a
      # DefaultErrorHandler + DeadLetterPublishingRecoverer bean, not per @KafkaListener.

# FORM B ONLY — transactional outbox + relay (`.claude/rules/messaging.md` § Publication
# timing). Omit this whole block under Form A, where there is no relay to configure.
# Shape of the component these values drive: `OutboxRelayPublisher.java.example`.
app:
  outbox:
    # The relay's on switch, and the one property the test profile cares about. Both
    # `OutboxRelay` and `SchedulingConfig` are `@ConditionalOnProperty` on it, defaulted on,
    # so `src/test/resources/application-test.yml` setting it to `false` is what keeps the
    # relay out of every `@SpringBootTest` — where it would otherwise poll the test database
    # and block on a broker no test starts (lessons-learned-013 § 3).
    enabled: true
    # Fixed delay between passes, never fixed rate: a slow pass must not overlap the next.
    # Read by `@Scheduled(fixedDelayString = ...)` as a placeholder, not through
    # `OutboxProperties` — the annotation is resolved before any bean exists.
    poll-interval: PT1S
    # Rows claimed per pass. Sized so a pass finishes well inside poll-interval.
    batch-size: 100
    # Send attempts before the row is flagged dead-lettered and stops being re-read.
    # Not the broker-side retry above: that one retries a single send, this one retries a row.
    max-attempts: 5
    # Retention for rows already published, swept by the pruning job. An outbox that only
    # grows becomes the slowest table in the schema.
    # SHIP THIS LINE ONLY WITH THE JOB THAT READS IT. Without the pruning job, it is a
    # property nothing reads, drifting from the retention the index and the table comment
    # assume, and read by a person as a guarantee the project does not make
    # (lessons-learned-013 § 8.6).
    prune-after: P7D
