-- EXEMPLAR — Flyway migration for the shared idempotency-key table.
-- Form reference; not a file to copy.
-- Rules: `.claude/rules/api-rest.md` § Idempotency · `.claude/rules/persistence.md` (§ Migrations)
--
-- ONE TABLE, SHARED BY THE WHOLE APPLICATION — not per use case, not per aggregate.
-- Every endpoint that requires `Idempotency-Key` writes to this same table
-- (`rest-api-architect` step 7 names it; this skill models it). Create it the first
-- time a use case needs `Idempotency-Key`; every use case after that reuses it —
-- never recreate it, never give it a foreign key to a specific aggregate.

-- ---------------------------------------------------------------------------
-- V2__create_idempotency_keys.sql — new table
-- ---------------------------------------------------------------------------

CREATE TABLE idempotency_keys (
    idempotency_key  uuid          NOT NULL,
    route            varchar(200)  NOT NULL,
    caller_identity  varchar(200)  NOT NULL,
    body_hash        char(64)      NOT NULL,   -- sha-256 hex of the request body
    status           varchar(20)   NOT NULL,   -- IN_PROGRESS | COMPLETED
    response_status  smallint      NULL,        -- filled once status = COMPLETED
    response_body    text          NULL,        -- filled once status = COMPLETED
    created_at       timestamptz   NOT NULL,
    expires_at       timestamptz   NOT NULL,    -- created_at + TTL, >= 24 h (`api-rest.md` § Idempotency)
    CONSTRAINT pk_idempotency_keys PRIMARY KEY (idempotency_key)
);

-- The primary key on `idempotency_key` alone IS the concurrency control: two requests
-- racing with the same key collide on INSERT, and the loser reads back the winner's row
-- to decide replay, 409 in-progress, or 409 reused (`templates/IdempotencyKeyStore.java.example`).
-- No separate UNIQUE constraint needed — the PK already is one.

-- Read at request time only by primary key. This index serves the cleanup job, not
-- request traffic.
CREATE INDEX ix_idempotency_keys_expires_at ON idempotency_keys (expires_at);

-- ---------------------------------------------------------------------------
-- Cleanup — its own scheduled job, not modeled by this migration
-- ---------------------------------------------------------------------------
-- Rows past `expires_at` are safe to delete regardless of `status`: a request still
-- IN_PROGRESS past its own TTL means the caller already gave up and retried with a new
-- key, or the process handling it died. Either way nothing reads the row again.
-- Batched, off-peak — a single unbounded DELETE on a hot table locks it.

-- DELETE FROM idempotency_keys WHERE expires_at < now();
