/*
 * EXEMPLAR — persistence side of `Idempotency-Key`. Form reference for the executor
 * agent; not a file to copy verbatim.
 * Rules: `.claude/rules/api-rest.md` (§ Idempotency) · `.claude/rules/persistence.md`
 *        (§ Boundary, § Mapping) · `.claude/rules/error-handling.md` (typed family)
 *        `.claude/rules/lombok.md` (`@Data` and `@Setter` forbidden)
 *
 * WHY THIS PORT ISN'T DECLARED IN `10-dominio.md`: every other port in this module
 * mirrors an output port `domain-modeling` wrote for one aggregate. This one doesn't —
 * it's shared infrastructure, the transactional mirror of `rest-api-architect`'s
 * `IdempotencyKeyInterceptor` (which only checks header shape). Model it once, the
 * first time some use case's `30-rest.md` requires `Idempotency-Key`; every use case
 * after that reuses the same table and the same port, never redeclares it.
 *
 * WHERE IT'S CALLED FROM: the application service, inside the SAME transaction that
 * persists the business effect (`.claude/rules/api-rest.md` § Idempotency — "key
 * recording and the business effect in the same transaction"). Sketch:
 *
 *     IdempotencyOutcome outcome = idempotencyKeys.begin(key, route, callerIdentity, bodyHash, clock.instant());
 *     if (outcome instanceof IdempotencyOutcome.Replay replay) {
 *         return replay;   // adapter writes it back verbatim, the use case never runs again
 *     }
 *     User created = ...;                        // the actual business logic
 *     idempotencyKeys.complete(key, 201, responseBodyOf(created));
 *     return created;
 *
 * Wiring that call into the application service is out of this skill's scope — it
 * writes no application code, only the table, the entity, and this adapter.
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- IdempotencyKeyPort.java
package com.example.demo.application.port.out;

import java.time.Instant;
import java.util.UUID;

// One instance for the whole application, not one per aggregate — see the exemplar's
// header comment for why this port has no domain-modeling counterpart.
public interface IdempotencyKeyPort {

    IdempotencyOutcome begin(UUID key, String route, String callerIdentity, String bodyHash, Instant now);

    void complete(UUID key, int responseStatus, String responseBody);
}

// --- IdempotencyOutcome.java
package com.example.demo.application.port.out;

// Proceed: no prior request with this key — run the use case, then call `complete`.
// Replay: a prior request with the same key AND the same body already finished —
// return this verbatim, the use case does not run again.
public sealed interface IdempotencyOutcome {
    record Proceed() implements IdempotencyOutcome {}
    record Replay(int status, String body) implements IdempotencyOutcome {}
}

// --- IdempotencyKeyEntity.java
package com.example.demo.adapter.out.persistence;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.Id;
import jakarta.persistence.Lob;
import jakarta.persistence.Table;
import java.time.Instant;
import java.util.UUID;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.experimental.FieldDefaults;   // experimental, NOT `lombok.FieldDefaults`

@Entity
@Table(name = "idempotency_keys")
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)   // required by Hibernate, closed to everyone else
@FieldDefaults(level = AccessLevel.PRIVATE)
class IdempotencyKeyEntity {

    // The key IS the primary key — global uniqueness is exactly the guarantee wanted,
    // and it's what makes the racing INSERT in `IdempotencyKeyStore.begin` the
    // concurrency control. No surrogate id.
    @Id
    @Column(name = "idempotency_key", nullable = false, updatable = false)
    UUID idempotencyKey;

    @Column(name = "route", nullable = false, length = 200, updatable = false)
    String route;

    @Column(name = "caller_identity", nullable = false, length = 200, updatable = false)
    String callerIdentity;

    @Column(name = "body_hash", nullable = false, length = 64, updatable = false)
    String bodyHash;

    @Enumerated(EnumType.STRING)   // never ORDINAL — reordering would corrupt stored rows
    @Column(name = "status", nullable = false, length = 20)
    IdempotencyStatus status;

    @Column(name = "response_status")
    Integer responseStatus;

    @Lob
    @Column(name = "response_body")
    String responseBody;

    @Column(name = "created_at", nullable = false, updatable = false)
    Instant createdAt;

    @Column(name = "expires_at", nullable = false, updatable = false)
    Instant expiresAt;

    IdempotencyKeyEntity(UUID idempotencyKey, String route, String callerIdentity, String bodyHash,
                         IdempotencyStatus status, Instant createdAt, Instant expiresAt) {
        this.idempotencyKey = idempotencyKey;
        this.route = route;
        this.callerIdentity = callerIdentity;
        this.bodyHash = bodyHash;
        this.status = status;
        this.createdAt = createdAt;
        this.expiresAt = expiresAt;
    }

    // No setter. The only state change this row ever makes: IN_PROGRESS -> COMPLETED.
    void applyResponse(int responseStatus, String responseBody) {
        this.status = IdempotencyStatus.COMPLETED;
        this.responseStatus = responseStatus;
        this.responseBody = responseBody;
    }
}

// --- IdempotencyStatus.java
package com.example.demo.adapter.out.persistence;

enum IdempotencyStatus { IN_PROGRESS, COMPLETED }

// --- IdempotencyKeyJpaRepository.java
package com.example.demo.adapter.out.persistence;

import java.time.Instant;
import java.util.List;
import java.util.UUID;
import org.springframework.data.jpa.repository.JpaRepository;

interface IdempotencyKeyJpaRepository extends JpaRepository<IdempotencyKeyEntity, UUID> {

    // Read by the cleanup job (`templates/IdempotencyKeyTable.sql.example`'s commented
    // DELETE, or a scheduled equivalent). Not called on the request path.
    List<IdempotencyKeyEntity> findByExpiresAtBefore(Instant cutoff);
}

// --- IdempotencyKeyStore.java
package com.example.demo.adapter.out.persistence;

import com.example.demo.application.port.out.IdempotencyKeyPort;
import com.example.demo.application.port.out.IdempotencyOutcome;
import com.example.demo.domain.exception.ConflictException;
import java.time.Duration;
import java.time.Instant;
import java.util.UUID;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.stereotype.Component;

@Component
class IdempotencyKeyStore implements IdempotencyKeyPort {

    private static final Duration TTL = Duration.ofHours(24);   // floor set by api-rest.md § Idempotency

    private final IdempotencyKeyJpaRepository repository;

    IdempotencyKeyStore(IdempotencyKeyJpaRepository repository) {
        this.repository = repository;
    }

    @Override
    public IdempotencyOutcome begin(UUID key, String route, String callerIdentity, String bodyHash, Instant now) {
        try {
            // saveAndFlush, not save: the INSERT has to reach the database now, inside
            // this try, for the UNIQUE violation on the primary key to surface here —
            // same reasoning as `RepositoryAdapter.java.example`'s `save`.
            repository.saveAndFlush(new IdempotencyKeyEntity(
                    key, route, callerIdentity, bodyHash, IdempotencyStatus.IN_PROGRESS, now, now.plus(TTL)));
            return new IdempotencyOutcome.Proceed();
        } catch (DataIntegrityViolationException cause) {
            // Lost the race: someone else already holds this key. Read their row back
            // to decide which of the three outcomes in api-rest.md's scenario table applies.
            IdempotencyKeyEntity existing = repository.findById(key).orElseThrow(() -> cause);

            if (!existing.getBodyHash().equals(bodyHash)) {
                throw new ConflictException("IDEMPOTENCY_KEY_REUSED",
                        "Idempotency-Key " + key + " was already used with a different request body", cause);
            }
            if (existing.getStatus() == IdempotencyStatus.IN_PROGRESS) {
                // 409 here; the interceptor/advice attaches Retry-After — that header
                // is a transport concern, not this adapter's.
                throw new ConflictException("IDEMPOTENCY_KEY_IN_PROGRESS",
                        "Request with Idempotency-Key " + key + " is still being processed", cause);
            }
            return new IdempotencyOutcome.Replay(existing.getResponseStatus(), existing.getResponseBody());
        }
    }

    @Override
    public void complete(UUID key, int responseStatus, String responseBody) {
        // Same row this transaction inserted in `begin` — never missing, never a second
        // flush's worth of race to handle.
        repository.findById(key).orElseThrow().applyResponse(responseStatus, responseBody);
    }
}
