/*
 * EXEMPLAR — unit test of `LoggingCommonsMethods`, written by `commons-logging-installer`
 * next to the classes it installs, in `src/test/java` under the same package. Compilable as-is
 * — not pseudo-code.
 *
 * What it proves: whatever the options, the advice proceeds exactly once, returns the join
 * point's own result, and rethrows its failure untouched. The log lines themselves are not
 * asserted — their shape belongs to `logback-spring.xml`'s pattern, and a test pinned to a
 * log string breaks on every harmless rewording.
 *
 * The four option combinations are one `@ParameterizedTest`, not four copies of the same
 * method (Sonar java:S5976, `.claude/rules/testing.md` § Assertions).
 */
package com.exemplo.minhaapi.commons.logging;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.BDDMockito.given;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;

import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.Signature;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;

class LoggingCommonsMethodsTest {

    private final ProceedingJoinPoint joinPoint = mock(ProceedingJoinPoint.class);
    private final Signature signature = mock(Signature.class);

    LoggingCommonsMethodsTest() {
        given(joinPoint.getSignature()).willReturn(signature);
        given(signature.getName()).willReturn("register");
        given(signature.getDeclaringType()).willReturn(LoggingCommonsMethodsTest.class);
        given(joinPoint.getArgs()).willReturn(new Object[] {"Ana", null});
    }

    @ParameterizedTest(name = "logReturn={0}, logParameters={1}")
    @CsvSource({"true, true", "true, false", "false, true", "false, false"})
    @DisplayName("proceeds once and returns the join point's result, whatever is logged")
    void proceedsAndReturnsTheResult(boolean logReturn, boolean logParameters) throws Throwable {
        given(joinPoint.proceed()).willReturn("registered");
        LoggingOptions options = new LoggingOptions(logReturn, logParameters);

        Object result = LoggingCommonsMethods.logInterceptJoinPoint(joinPoint, options);

        assertThat(result).isEqualTo("registered");
        verify(joinPoint).proceed();
    }

    @Test
    @DisplayName("logs everything when no options are given")
    void defaultsToLoggingEverything() throws Throwable {
        given(joinPoint.proceed()).willReturn("registered");

        Object result = LoggingCommonsMethods.logInterceptJoinPoint(joinPoint);

        assertThat(result).isEqualTo("registered");
        verify(joinPoint).proceed();
    }

    @Test
    @DisplayName("rethrows exactly what the join point threw, unwrapped")
    void rethrowsWhatTheJoinPointThrew() throws Throwable {
        IllegalStateException failure = new IllegalStateException("boom");
        given(joinPoint.proceed()).willThrow(failure);

        assertThatThrownBy(() -> LoggingCommonsMethods.logInterceptJoinPoint(joinPoint))
                .isSameAs(failure);
    }
}
