/*
 * EXEMPLAR — the single writer of every 401 and 403 body. Two paths reach it:
 *
 *   1. The filter chain refuses a request (no token, bad token, a request rule fails) →
 *      `ProblemDetailAuthenticationEntryPoint` / `ProblemDetailAccessDeniedHandler` hand the
 *      exception to the MVC resolvers → here.
 *   2. Method security refuses a controller call (`@PreAuthorize`) → the denial is thrown
 *      inside the dispatcher servlet → here, ahead of `ApiExceptionHandler`.
 *
 * WHY THE ORDER MATTERS: `ApiExceptionHandler` has a catch-all `@ExceptionHandler(Exception.class)`.
 * Without `@Order(Ordered.HIGHEST_PRECEDENCE)` on this advice, a method-security denial is
 * answered with 500 and a `traceId` — `.claude/rules/authorization.md` § Failure responses.
 *
 * 401 OR 403 FOR A DENIAL: a denial for an anonymous caller is "you did not authenticate" (401
 * with the challenge), not "you may not" (403). The trust resolver tells the two apart; the
 * filter chain makes the same distinction, and this keeps method security consistent with it.
 *
 * THE BODY SAYS NOTHING SPECIFIC: no missing role, no token parse error, no expiry time. The
 * reason goes to the log at DEBUG here; the WARN line with the principal is
 * `SecurityAuditListener`'s, from the framework's events, so a refusal is not logged twice.
 *
 * NO `errorCode`: the extension field belongs to errors that come from the domain
 * (`.claude/rules/api-rest.md` § Error body). An ownership refusal is not handled here at all —
 * the use case raises the resource's not-found exception and `ApiExceptionHandler` answers 404.
 */
package com.exemplo.minhaapi.adapter.in.rest.security;

import jakarta.servlet.http.HttpServletRequest;
import java.net.URI;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.core.Ordered;
import org.springframework.core.annotation.Order;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ProblemDetail;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.AccessDeniedException;
import org.springframework.security.authentication.AuthenticationTrustResolver;
import org.springframework.security.authentication.AuthenticationTrustResolverImpl;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.AuthenticationException;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.core.context.SecurityContextHolderStrategy;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

@RestControllerAdvice
@Order(Ordered.HIGHEST_PRECEDENCE)
public class SecurityExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(SecurityExceptionHandler.class);

    private final AuthenticationMechanism mechanism;
    private final AuthenticationTrustResolver trustResolver = new AuthenticationTrustResolverImpl();
    private final SecurityContextHolderStrategy contextHolder = SecurityContextHolder.getContextHolderStrategy();

    public SecurityExceptionHandler(AuthenticationMechanism mechanism) {
        this.mechanism = mechanism;
    }

    @ExceptionHandler(AuthenticationException.class)
    public ResponseEntity<ProblemDetail> handleAuthentication(
            AuthenticationException e, HttpServletRequest request) {
        log.debug("Authentication refused at {} {}: {}", request.getMethod(), request.getRequestURI(), e.getClass().getSimpleName());
        return unauthorized(request);
    }

    /** Covers the method-security denial too: its exception extends this one. */
    @ExceptionHandler(AccessDeniedException.class)
    public ResponseEntity<ProblemDetail> handleAccessDenied(AccessDeniedException e, HttpServletRequest request) {
        Authentication authentication = contextHolder.getContext().getAuthentication();
        if (authentication == null || trustResolver.isAnonymous(authentication)) {
            return unauthorized(request);
        }
        log.debug("Access denied at {} {}", request.getMethod(), request.getRequestURI());
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(HttpStatus.FORBIDDEN, "Access denied");
        problem.setInstance(URI.create(request.getRequestURI()));
        return ResponseEntity.status(HttpStatus.FORBIDDEN).body(problem);
    }

    private ResponseEntity<ProblemDetail> unauthorized(HttpServletRequest request) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(HttpStatus.UNAUTHORIZED, "Authentication required");
        problem.setInstance(URI.create(request.getRequestURI()));
        return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                .header(HttpHeaders.WWW_AUTHENTICATE, mechanism.challengeScheme())
                .body(problem);
    }
}
