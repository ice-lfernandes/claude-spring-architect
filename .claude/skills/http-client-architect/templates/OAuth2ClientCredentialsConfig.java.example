/*
 * EXEMPLAR — outbound authentication, OAuth2 CLIENT CREDENTIALS: this service authenticates as
 * itself (a machine identity) to a provider protected by an authorization server. The default for
 * service-to-service calls when the provider issues tokens.
 * Form reference for the executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/http-client.md` § Outbound authentication
 *
 * WHAT THIS EXEMPLAR SHOWS:
 *  - the token is obtained, cached and renewed by Spring Security's authorized-client manager — one
 *    token per registration, reused until shortly before it expires; never fetched per call, never
 *    cached by hand;
 *  - `AuthorizedClientServiceOAuth2AuthorizedClientManager`, not the request-bound manager: the call
 *    may run on a job or listener thread with no HTTP request around it;
 *  - `OAuth2RestClientHttpServiceGroupConfigurer` attaches the interceptor to every HTTP-interface
 *    group; it only acts on a call whose interface or method carries `@ClientRegistrationId`, so a
 *    group without the annotation is untouched;
 *  - the registration (client id, secret from an environment variable, token URI, scopes) lives in
 *    `application-http-client.yml.example`, under `spring.security.oauth2.client.*`;
 *  - for `RestClient` direct, the same manager goes into an `OAuth2ClientHttpRequestInterceptor` with
 *    a fixed registration-id resolver — second bean below.
 *
 * DEPENDENCY AND ITS SIDE EFFECT: `spring-boot-starter-security-oauth2-client` (Initializr
 * `oauth2-client`). It brings Spring Security: in a project with no `SecurityFilterChain` yet, Boot's
 * default chain then answers 401 on every endpoint but `/actuator/health` (observed on Boot 4.1.1).
 * The partial's § 10 records this as an impact when no chain exists — the inbound side is then
 * decided by the security design, never by accident here.
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- shared/OAuth2ClientCredentialsConfig.java
package com.exemplo.minhaapi.adapter.out.http.shared;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.oauth2.client.AuthorizedClientServiceOAuth2AuthorizedClientManager;
import org.springframework.security.oauth2.client.OAuth2AuthorizedClientManager;
import org.springframework.security.oauth2.client.OAuth2AuthorizedClientProviderBuilder;
import org.springframework.security.oauth2.client.OAuth2AuthorizedClientService;
import org.springframework.security.oauth2.client.registration.ClientRegistrationRepository;
import org.springframework.security.oauth2.client.web.client.support.OAuth2RestClientHttpServiceGroupConfigurer;

@Configuration
public class OAuth2ClientCredentialsConfig {

    @Bean
    OAuth2AuthorizedClientManager outboundAuthorizedClientManager(ClientRegistrationRepository registrations,
                                                                  OAuth2AuthorizedClientService authorizedClients) {
        AuthorizedClientServiceOAuth2AuthorizedClientManager manager =
                new AuthorizedClientServiceOAuth2AuthorizedClientManager(registrations, authorizedClients);
        manager.setAuthorizedClientProvider(OAuth2AuthorizedClientProviderBuilder.builder().clientCredentials().build());
        return manager;
    }

    @Bean
    OAuth2RestClientHttpServiceGroupConfigurer oauth2HttpServiceGroups(OAuth2AuthorizedClientManager outboundAuthorizedClientManager) {
        return OAuth2RestClientHttpServiceGroupConfigurer.from(outboundAuthorizedClientManager);
    }
}

// --- paymentgateway/PaymentGatewayHttpService.java (the annotation that selects the registration)
package com.exemplo.minhaapi.adapter.out.http.paymentgateway;

import org.springframework.security.oauth2.client.annotation.ClientRegistrationId;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.service.annotation.GetExchange;
import org.springframework.web.service.annotation.HttpExchange;

@HttpExchange("/v1/charges")
@ClientRegistrationId("payment-gateway")
interface PaymentGatewayHttpService {

    @GetExchange("/{id}")
    String getCharge(@PathVariable String id);
}

// --- carrier/CarrierOAuth2Config.java (RestClient direct: the interceptor on the client itself)
package com.exemplo.minhaapi.adapter.out.http.carrier;

import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.oauth2.client.OAuth2AuthorizedClientManager;
import org.springframework.security.oauth2.client.web.client.OAuth2ClientHttpRequestInterceptor;
import org.springframework.web.client.RestClient;

@Configuration
class CarrierOAuth2Config {

    @Bean
    @Qualifier("carrierRestClient")
    RestClient carrierRestClient(RestClient.Builder builder, OAuth2AuthorizedClientManager outboundAuthorizedClientManager) {
        OAuth2ClientHttpRequestInterceptor oauth2 = new OAuth2ClientHttpRequestInterceptor(outboundAuthorizedClientManager);
        oauth2.setClientRegistrationIdResolver(request -> "carrier");
        return builder.requestInterceptor(oauth2).build();
    }
}
