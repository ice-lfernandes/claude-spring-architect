/*
 * EXEMPLAR — OpenAPI documentation extracted into composed annotations, suffix
 * `OpenApiDocs`. One per operation (`Create<Resource>OpenApiDocs`,
 * `List<Resource(s)>OpenApiDocs`, `Get<Resource>OpenApiDocs`...), never one shared
 * across the resource: each operation's summary, responses and examples differ, and a
 * shared annotation would force lowest-common-denominator docs.
 *
 * Every composed annotation carries, per `.claude/rules/api-rest.md` § OpenAPI:
 *   - @Operation with summary + stable operationId
 *   - @ApiResponse for every status the operation returns, success and error, each
 *     error pointing at the ProblemDetail schema
 *   - @Parameter with description AND example for every path/query/header parameter,
 *     declared inside @Operation(parameters = {...}) since the annotation sits on the
 *     method, not on each parameter
 *   - when there's a request body: @Operation(requestBody = ...) with a concrete JSON
 *     @ExampleObject, never just a @Schema reference
 *
 * These composed annotations go on the contract interface's method (`Api.java.example`)
 * ALONE — no `@PostMapping`/`@GetMapping`, no binding annotation sits next to them there.
 * Those live on the implementing controller instead (`Controller.java.example`), which
 * carries none of these doc annotations. Spring still resolves them off the implemented
 * interface's method at request time, so repeating them on the implementation would
 * duplicate the same fact in two places, which `@CLAUDE.md` invariant 2 forbids even for
 * code — the split is by kind (doc vs. runtime-functional), not by which file has room.
 *
 * Requires springdoc-openapi to resolve swagger-core annotations as meta-annotations
 * (annotation-on-annotation) — supported since springdoc-openapi 1.6 / swagger-core 2.2.
 * Confirm against the resolved version, `references/best-practices-links.md` §
 * Resolving the springdoc version — never from memory (`@CLAUDE.md` invariant 8).
 *
 * Three top-level types share this file only because they're small and reviewed
 * together; in the real project each is its own file
 * (`CreateUserOpenApiDocs.java`, `ListUsersOpenApiDocs.java`, `GetUserOpenApiDocs.java`),
 * same package as the controller's `openapi` sub-package.
 */
package com.exemplo.minhaapi.adapter.in.rest.openapi;

import com.exemplo.minhaapi.adapter.in.rest.dto.CreateUserRequest;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.enums.ParameterIn;
import io.swagger.v3.oas.annotations.media.Content;
import io.swagger.v3.oas.annotations.media.ExampleObject;
import io.swagger.v3.oas.annotations.media.Schema;
import io.swagger.v3.oas.annotations.parameters.RequestBody;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import java.lang.annotation.ElementType;
import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.lang.annotation.Target;
import org.springframework.http.ProblemDetail;

/** Goes on `UserApi#create` alone — `@PostMapping` lives on `UserController#create` instead. */
@Target(ElementType.METHOD)
@Retention(RetentionPolicy.RUNTIME)
@Operation(
        summary = "Creates a user",
        // stable operationId: becomes a method name in the generated client. Changing it
        // breaks consumers — it's a contract, not a label.
        operationId = "createUser",
        parameters = {
            @Parameter(
                    name = "Idempotency-Key",
                    in = ParameterIn.HEADER,
                    required = true,
                    description = "UUID generated by the client. Repeating the request with the"
                            + " same key returns the stored response.",
                    example = "3fa85f64-5717-4562-b3fc-2c963f66afa6")
        },
        requestBody =
                @RequestBody(
                        required = true,
                        description = "Data of the user to create",
                        content =
                                @Content(
                                        schema = @Schema(implementation = CreateUserRequest.class),
                                        examples =
                                                @ExampleObject(
                                                        name = "minimal",
                                                        value =
                                                                """
                                                                {
                                                                  "email": "ana.silva@exemplo.com",
                                                                  "name": "Ana Silva"
                                                                }
                                                                """))))
@ApiResponse(responseCode = "201", description = "Created")
@ApiResponse(
        responseCode = "400",
        description = "Invalid body, or Idempotency-Key missing or malformed",
        content = @Content(schema = @Schema(implementation = ProblemDetail.class)))
@ApiResponse(
        responseCode = "409",
        description = "Email already registered, or Idempotency-Key reused with a different body",
        content = @Content(schema = @Schema(implementation = ProblemDetail.class)))
@ApiResponse(
        responseCode = "422",
        description = "Business rule violated",
        content = @Content(schema = @Schema(implementation = ProblemDetail.class)))
public @interface CreateUserOpenApiDocs {}

/**
 * Goes on `UserApi#list` alone — `@GetMapping` and the `@ParameterObject
 * @PageableDefault Pageable pageable` parameter live on `UserController#list` instead
 * (`Controller.java.example`). springdoc still needs these three `@Parameter`s by name
 * to attach a description and example; it merges them with what it infers from
 * `Pageable` instead of documenting an opaque object.
 */
@Target(ElementType.METHOD)
@Retention(RetentionPolicy.RUNTIME)
@Operation(
        summary = "Lists users",
        operationId = "listUsers",
        parameters = {
            @Parameter(name = "page", in = ParameterIn.QUERY, description = "Page, 0-based", example = "0"),
            // Maximum 100: above that is 400. Truncating silently makes the client believe
            // it saw everything.
            @Parameter(
                    name = "size",
                    in = ParameterIn.QUERY,
                    description = "Elements per page, maximum 100",
                    example = "20"),
            // Stable ordering: the unique-key tiebreak is added in the application, not
            // requested from the client. Without it page 2 repeats and skips records.
            @Parameter(
                    name = "sort",
                    in = ParameterIn.QUERY,
                    description = "field,asc|desc",
                    example = "createdAt,desc")
        })
@ApiResponse(responseCode = "200", description = "Page of users, possibly empty")
@ApiResponse(
        responseCode = "400",
        description = "size above the maximum, or unknown sort",
        content = @Content(schema = @Schema(implementation = ProblemDetail.class)))
public @interface ListUsersOpenApiDocs {}

/** Goes on `UserApi#get` alone — `@GetMapping("/{userId}")` lives on `UserController#get` instead. */
@Target(ElementType.METHOD)
@Retention(RetentionPolicy.RUNTIME)
@Operation(
        summary = "Gets a user",
        operationId = "getUser",
        parameters = {
            @Parameter(
                    name = "userId",
                    in = ParameterIn.PATH,
                    required = true,
                    description = "Opaque user identifier",
                    example = "3f1c9a2e-6b7d-4e2a-9c1f-8a0d5e2b7c11")
        })
@ApiResponse(responseCode = "200", description = "User")
@ApiResponse(
        responseCode = "404",
        description = "Doesn't exist",
        content = @Content(schema = @Schema(implementation = ProblemDetail.class)))
public @interface GetUserOpenApiDocs {}
