/*
 * EXEMPLAR — the STRUCTURAL half of idempotency: header presence and format.
 * Compilable as-is.
 *
 * READ THIS BEFORE COPYING. Idempotency splits into two halves, and this file is
 * only the first (decision P5(b), `.claude/decisions/0006-rest-api-architect-design.md`):
 *
 *   1. STRUCTURAL — here. Missing or non-UUID header on a route that requires it: 400, and
 *      the request never reaches the controller.
 *   2. TRANSACTIONAL — NOT here. `.claude/rules/api-rest.md` § Idempotency fixes two
 *      transactions: the claim commits on its own, then the business effect and the
 *      stored response commit together. This runs before the body is even parsed, so it
 *      has neither the body hash nor the effect. That half lives in the application
 *      layer, where transactions open (`.claude/rules/architecture-ddd.md` § Application):
 *      `@.claude/skills/persistence-architect/templates/IdempotentExecution.java.example`,
 *      driven by `IdempotencyAspect.java.example` via `@Idempotent` on the controller
 *      method — never a by-hand call from here.
 *
 * WHY IT'S AN INTERCEPTOR AND NOT A FILTER. A `Filter` runs before the `DispatcherServlet`,
 * and an exception thrown there does NOT go through `@RestControllerAdvice` — the response
 * comes out without `ProblemDetail`, outside the rule's contract. `HandlerInterceptor` runs
 * inside the dispatcher, so `ApiExceptionHandler` catches the exception and the error body
 * comes out in the right shape. If you prefer a filter, you have to serialize the
 * `ProblemDetail` by hand in there.
 *
 * PACKAGE. Every idempotency artifact — this file, `MissingIdempotencyKeyException` below,
 * and everything `IdempotencyAspect.java.example` declares (`Idempotent`,
 * `IdempotencyRequestHasher`, `IdempotencyResponseCodec`, `AspectInvocationException`) —
 * lives together in its own `idempotent` subpackage of the inbound REST adapter, not
 * loose in the adapter's root package. It's a cohesive unit read and changed as one, and
 * the split keeps the controller/DTO/mapper files from scrolling past it. Shown here as
 * `adapter.in.rest.idempotent` to match this folder's sibling exemplars — package per the
 * active blueprint's `packages.map`.
 *
 * The table that stores route, caller identity, body hash, status, and response body
 * (TTL >= 24 h) belongs to `20-persistencia.md`. The `30-rest.md` partial declares it's
 * needed and names it; it doesn't model it. Shape reference for the other half:
 * `@.claude/skills/persistence-architect/templates/IdempotencyKeyTable.sql.example` and
 * `.../IdempotencyKeyStore.java.example`, and `.../IdempotentExecution.java.example`.
 */
package com.exemplo.minhaapi.adapter.in.rest.idempotent;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.util.Set;
import java.util.UUID;
import org.springframework.http.HttpMethod;
import org.springframework.stereotype.Component;
import org.springframework.web.servlet.HandlerInterceptor;

@Component
public class IdempotencyKeyInterceptor implements HandlerInterceptor {

    public static final String HEADER = "Idempotency-Key";

    // Routes that require the key: POST that creates a resource, moves money, or touches an
    // external system. Explicit list — requiring it across the whole API puts 400 on harmless actions.
    private static final Set<String> PROTECTED_POST_PATHS = Set.of("/api/v1/users");

    @Override
    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) {
        if (!requiresKey(request)) {
            return true;
        }

        String key = request.getHeader(HEADER);
        if (key == null || !isUuid(key)) {
            throw new MissingIdempotencyKeyException("Header " + HEADER + " missing or malformed");
        }

        return true;
    }

    private boolean requiresKey(HttpServletRequest request) {
        return HttpMethod.POST.matches(request.getMethod())
                && PROTECTED_POST_PATHS.contains(request.getRequestURI());
    }

    private static boolean isUuid(String value) {
        try {
            UUID.fromString(value);
            return true;
        } catch (IllegalArgumentException e) {
            return false;
        }
    }
}

// --- MissingIdempotencyKeyException.java
package com.exemplo.minhaapi.adapter.in.rest.idempotent;

// Thrown by IdempotencyKeyInterceptor when Idempotency-Key is missing or malformed.
// Deliberately NOT a DomainException: `.claude/rules/api-rest.md` § Errors classifies this
// case as adapter/structural, same family as bean validation — the request never reached
// the use case, so the response carries `violations` and no `errorCode`
// (ApiExceptionHandler#handleMissingIdempotencyKey, ApiExceptionHandler.java.example).
public class MissingIdempotencyKeyException extends RuntimeException {
    public MissingIdempotencyKeyException(String message) {
        super(message);
    }
}

/*
 * Registration. Its own file in the real project (`WebMvcConfig.java`), in the same module.
 *
 * @Configuration
 * class WebMvcConfig implements WebMvcConfigurer {
 *     private final IdempotencyKeyInterceptor interceptor;
 *     WebMvcConfig(IdempotencyKeyInterceptor interceptor) { this.interceptor = interceptor; }
 *     @Override public void addInterceptors(InterceptorRegistry registry) {
 *         registry.addInterceptor(interceptor).addPathPatterns("/api/**");
 *     }
 * }
 */

/*
 * ANNOTATION-BASED VARIANT — only `requiresKey` and its supporting field change;
 * `preHandle`, `isUuid`, and the `WebMvcConfig` registration above stay as written.
 *
 * Switch to this once `IdempotencyAspect.java.example` is the project's chosen strategy
 * (rest-api-architect's SKILL.md § "Fix pagination and idempotency": second
 * `Idempotency-Key` endpoint onward). A hardcoded path set has one advantage this loses:
 * it still works for a project using the by-hand `IdempotentExecution` call without ever
 * introducing `@Idempotent`. Don't make this switch for a single-endpoint project.
 *
 * import org.springframework.web.method.HandlerMethod;
 *
 * private boolean requiresKey(HttpServletRequest request, Object handler) {
 *     // The annotation is the single source of truth both this interceptor
 *     // (structural check) and IdempotencyAspect (transactional check) read — a second
 *     // annotated endpoint needs no change here.
 *     return handler instanceof HandlerMethod handlerMethod
 *             && handlerMethod.hasMethodAnnotation(Idempotent.class);
 * }
 *
 * // preHandle's signature already receives `handler` — pass it to requiresKey instead
 * // of PROTECTED_POST_PATHS/HttpMethod.POST.matches(request.getMethod()).
 */
